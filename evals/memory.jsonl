// Memory suite — is automatic recall worth what it costs?
// Spec: docs/specs/2026-09-25-memory-efficiency-and-graph-explorer.md §6.
//
// Every case is sandboxed and carries a `memories` fixture, seeded into the
// trial's own store and frozen for the trial (extraction + consolidation off).
// Run it paired, never alone:
//
//   pnpm eval ab memory --baseline env:FREECODE_DISABLE_MEMORY_RECALL=1 \
//     --candidate env:FREECODE_DISABLE_MEMORY_JUDGE=1 --trials 3
//
// Checks are INLINE (`node -e`), not a check.mjs: a checker file in the sandbox
// would show the agent the expected answer, and the no-memory side could pass
// by reading it. The `control-*` cases have only unrelated memories; they
// measure what carrying the block costs when it cannot help.
//
// Generated by the script recorded in the spec; each check is proven to fail
// on the fixture and pass on a reference fix before the suite ships.
{"id": "recall-date-convention", "prompt": "Add and export a formatDate(date) function in dates.mjs that formats a Date for the invoice footer.", "failureCategory": "memory-recall", "whyModelBacked": "Which date format to use is a team convention stored only in memory; nothing in the repo implies it, so only recall (or a lucky guess) produces the right format.", "files": {"dates.mjs": "// Date helpers for invoices.\n", "invoice.mjs": "import { formatDate } from './dates.mjs';\nexport const footer = (d) => `Issued ${formatDate(d)}`;\n"}, "memories": [{"type": "feedback", "name": "iso-dates-only", "description": "All user-facing dates use ISO 8601 YYYY-MM-DD, never locale formats", "content": "Format every user-facing date as YYYY-MM-DD in UTC (e.g. 2026-01-05). Locale formats caused a billing dispute between the US and German clients."}, {"type": "user", "name": "timezone-ist", "description": "User works in IST (UTC+5:30); schedules assume Asia/Kolkata", "content": "Dates and times in conversation default to Asia/Kolkata unless stated otherwise."}], "verify": "node --input-type=module -e \"import {formatDate} from './dates.mjs'; import assert from 'node:assert'; assert.equal(formatDate(new Date(Date.UTC(2026,0,5,23,30))), '2026-01-05'); assert.equal(formatDate(new Date(Date.UTC(2025,11,31))), '2025-12-31'); console.log('ok');\"", "expectMaxTurns": 15}
{"id": "recall-money-in-cents", "prompt": "Add and export applyDiscount(price, percent) to pricing.mjs; it returns the discounted price.", "failureCategory": "memory-recall", "whyModelBacked": "Whether prices are integer cents or float dollars, and how to round, is a repo rule held in memory; the fixture is deliberately silent on it.", "files": {"pricing.mjs": "// Pricing helpers.\nexport const TAX_RATE = 0.2;\n"}, "memories": [{"type": "project", "name": "money-integer-cents", "description": "Prices are integer cents everywhere; never floats or dollars", "content": "Every price in this repo is an integer number of cents, in and out. Round with Math.round (half up). applyDiscount(1999, 15) must return 1699."}, {"type": "feedback", "name": "terse-summaries", "description": "User wants two-sentence summaries at the end of a task", "content": "End with what changed and what to watch, in two sentences. Do not re-narrate steps."}], "verify": "node --input-type=module -e \"import {applyDiscount} from './pricing.mjs'; import assert from 'node:assert'; assert.equal(applyDiscount(1999, 15), 1699); assert.equal(applyDiscount(1000, 33), 670); assert.ok(Number.isInteger(applyDiscount(999, 10))); console.log('ok');\"", "expectMaxTurns": 15}
{"id": "recall-forbidden-install", "prompt": "node test.mjs fails with a module-not-found error. Make it pass.", "failureCategory": "memory-recall", "whyModelBacked": "The repo vendors its dependency and the team forbids npm install (it rewrites the lockfile); only memory carries that rule, and forbidBashMatches scores whether it was honoured.", "files": {"test.mjs": "import leftpad from 'leftpad';\nimport assert from 'node:assert';\nassert.equal(leftpad('7', 3, '0'), '007');\nconsole.log('ok');\n", "vendor/leftpad/index.mjs": "export default function leftpad(s, n, c = ' ') { return String(s).padStart(n, c); }\n", "package.json": "{\n  \"name\": \"fixture\",\n  \"type\": \"module\"\n}\n"}, "memories": [{"type": "feedback", "name": "never-npm-install", "description": "Never run npm/pnpm/yarn install here; dependencies are vendored under vendor/", "content": "Dependencies are vendored in vendor/. Never run npm install, pnpm install or yarn: it rewrites the lockfile and breaks the offline build. Import from ./vendor/<name>/index.mjs instead."}, {"type": "reference", "name": "ci-dashboard", "description": "CI dashboard lives at ci.internal/freecode", "content": "Build history and flaky-test reports: https://ci.internal/freecode"}], "verify": "node test.mjs", "expectMaxTurns": 15, "forbidBashMatches": "\\b(npm|pnpm|yarn)\\s+(i|install|add)\\b"}
{"id": "recall-past-decision", "prompt": "Should we add Postgres support for session storage? Write a one-paragraph recommendation, with the reason, to DECISION.md.", "failureCategory": "memory-recall", "whyModelBacked": "The decision and its reason (zero external services) were made in an earlier session and live only in memory; a reasonable answer without it recommends Postgres or hedges.", "files": {"README.md": "# fixture-cli\n\nA command-line tool. Sessions are stored locally.\n", "store.mjs": "// Session store.\nexport const open = (file) => ({ file });\n"}, "memories": [{"type": "project", "name": "sqlite-over-postgres", "description": "Chose SQLite over Postgres for sessions: the CLI must run with zero external services", "content": "Decided 2026-08: sessions stay in SQLite. The CLI must install and run with zero external services (no database server). Revisit only if multi-user sync becomes a requirement."}, {"type": "user", "name": "timezone-ist", "description": "User works in IST (UTC+5:30); schedules assume Asia/Kolkata", "content": "Dates and times in conversation default to Asia/Kolkata unless stated otherwise."}], "verify": "node --input-type=module -e \"import {readFileSync} from 'node:fs'; const t = readFileSync('DECISION.md','utf8'); if (!/sqlite/i.test(t)) throw new Error('no sqlite'); if (!/(external|separate|standalone)\\\\s+(services?|servers?|dependenc)|no\\\\s+(database\\\\s+)?server|zero[- ]dependenc/i.test(t)) throw new Error('no reason'); if (/\\\\brecommend(ed)?\\\\s+(adding|we add)\\\\s+postgres/i.test(t)) throw new Error('recommends postgres'); console.log('ok');\"", "expectMaxTurns": 15}
{"id": "recall-saves-investigation", "prompt": "Double the retry base delay.", "failureCategory": "memory-recall", "whyModelBacked": "The real setting is in an unobvious module and a decoy config file matches every search for 'retry'; memory points straight at the right file, which is what this case measures in turns and tool calls.", "files": {"config/retry.json": "{\n  \"retryBaseMs\": 200,\n  \"_note\": \"legacy, read by nothing since the v2 client\"\n}\n", "src/net/policy/limits.mjs": "export const RETRY_BASE_MS = 200;\nexport const RETRY_MAX = 5;\n", "src/net/client.mjs": "import { RETRY_BASE_MS, RETRY_MAX } from './policy/limits.mjs';\nexport const backoff = (n) => Math.min(n, RETRY_MAX) * RETRY_BASE_MS;\n", "src/ui/view.mjs": "export const render = () => 'ok';\n"}, "memories": [{"type": "reference", "name": "retry-config-location", "description": "Retry backoff is set in src/net/policy/limits.mjs (RETRY_BASE_MS); config/retry.json is dead", "content": "RETRY_BASE_MS in src/net/policy/limits.mjs is the only live retry setting. config/retry.json is a legacy file nothing reads."}, {"type": "feedback", "name": "terse-summaries", "description": "User wants two-sentence summaries at the end of a task", "content": "End with what changed and what to watch, in two sentences. Do not re-narrate steps."}], "verify": "node --input-type=module -e \"import {RETRY_BASE_MS} from './src/net/policy/limits.mjs'; import assert from 'node:assert'; assert.equal(RETRY_BASE_MS, 400); console.log('ok');\"", "expectMaxTurns": 15}
{"id": "recall-superseded-fact", "prompt": "Set BASE_URL in client.mjs to our production API.", "failureCategory": "memory-recall", "whyModelBacked": "The production URL changed; both the old and the replacing memory are in the store, so this measures whether recall injects the current one and not the obsolete one.", "files": {"client.mjs": "export const BASE_URL = 'http://localhost:8080';\n"}, "memories": [{"type": "project", "name": "prod-api-v1", "description": "Production API base URL is https://api-v1.acme.test", "content": "Production API: https://api-v1.acme.test"}, {"type": "project", "name": "prod-api-v2", "description": "Production API base URL is https://api.v2.acme.test (replaced v1 in 2026-07)", "content": "Production API since 2026-07: https://api.v2.acme.test . The v1 host is being shut down.", "supersedes": ["prod-api-v1"]}], "verify": "node --input-type=module -e \"import {BASE_URL} from './client.mjs'; import assert from 'node:assert'; assert.equal(BASE_URL.replace(/\\\\/$/, ''), 'https://api.v2.acme.test'); console.log('ok');\"", "expectMaxTurns": 15}
{"id": "control-fix-bug", "prompt": "sum() in math.mjs returns the wrong result. Fix it.", "failureCategory": "memory-recall", "whyModelBacked": "Control for negative transfer: an ordinary bug fix where no stored memory applies, so any cost or failure difference between sides is the price of carrying the memory block.", "files": {"math.mjs": "export const sum = (xs) => xs.reduce((a, b) => a - b, 0);\n"}, "memories": [{"type": "user", "name": "timezone-ist", "description": "User works in IST (UTC+5:30); schedules assume Asia/Kolkata", "content": "Dates and times in conversation default to Asia/Kolkata unless stated otherwise."}, {"type": "feedback", "name": "terse-summaries", "description": "User wants two-sentence summaries at the end of a task", "content": "End with what changed and what to watch, in two sentences. Do not re-narrate steps."}, {"type": "reference", "name": "ci-dashboard", "description": "CI dashboard lives at ci.internal/freecode", "content": "Build history and flaky-test reports: https://ci.internal/freecode"}], "verify": "node --input-type=module -e \"import {sum} from './math.mjs'; import assert from 'node:assert'; assert.equal(sum([1,2,3]), 6); assert.equal(sum([]), 0); console.log('ok');\"", "expectMaxTurns": 15}
{"id": "control-implement", "prompt": "Add and export isPalindrome(s) to text.mjs. Ignore case and non-letters.", "failureCategory": "memory-recall", "whyModelBacked": "Control for negative transfer: a small implementation task with only unrelated memories in the store.", "files": {"text.mjs": "export const upper = (s) => s.toUpperCase();\n"}, "memories": [{"type": "user", "name": "timezone-ist", "description": "User works in IST (UTC+5:30); schedules assume Asia/Kolkata", "content": "Dates and times in conversation default to Asia/Kolkata unless stated otherwise."}, {"type": "feedback", "name": "terse-summaries", "description": "User wants two-sentence summaries at the end of a task", "content": "End with what changed and what to watch, in two sentences. Do not re-narrate steps."}, {"type": "reference", "name": "ci-dashboard", "description": "CI dashboard lives at ci.internal/freecode", "content": "Build history and flaky-test reports: https://ci.internal/freecode"}], "verify": "node --input-type=module -e \"import {isPalindrome} from './text.mjs'; import assert from 'node:assert'; assert.equal(isPalindrome('A man, a plan, a canal: Panama'), true); assert.equal(isPalindrome('abc'), false); console.log('ok');\"", "expectMaxTurns": 15}
