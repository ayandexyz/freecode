// Multi-session memory suite — does memory LEARN, and what does learning cost?
// Spec: docs/specs/2026-09-25-memory-efficiency-and-graph-explorer.md §7.
//
// Each case runs its `sessions` first, each in its own fresh session on the
// same sandbox project (and so the same, initially empty, memory store), ended
// the way the daemon ends one, session-end extraction flush included. Only the
// final `prompt` is scored; tokens and cost are summed over every session, so
// extraction's cost is inside the number. Run it paired:
//
//   pnpm eval ab memory-sessions \
//     --baseline env:FREECODE_DISABLE_MEMORY_RECALL=1,env:FREECODE_DISABLE_MEMORY_EXTRACTION=1 \
//     --candidate env:FREECODE_DISABLE_MEMORY_RECALL=0 --trials 3
//
// Earlier sessions teach through conversation only and are told not to edit:
// files persist across a trial's sessions, so a fact written to disk would be
// findable without memory. Consolidation cannot fire here (one run per project
// per day, after 5 sessions), so this measures capture + recall, not merging.
//
// Generated with each check proven to fail on the fixture and pass on a
// reference fix before the suite ships.
{"id": "learn-date-convention", "prompt": "Add and export a formatDate(date) function in dates.mjs that formats a Date for the invoice footer.", "failureCategory": "memory-recall", "whyModelBacked": "The date convention was stated only in an earlier session's conversation; the final session can get it right only if memory captured and recalled it.", "files": {"dates.mjs": "// Date helpers for invoices.\n", "invoice.mjs": "import { formatDate } from './dates.mjs';\nexport const footer = (d) => `Issued ${formatDate(d)}`;\n"}, "sessions": ["Quick question before next week's invoice work: our rule here is that every user-facing date is ISO 8601 YYYY-MM-DD in UTC — locale formats once caused a billing dispute between our US and German clients. Does anything in invoice.mjs look like it formats dates? Just answer, don't change files."], "verify": "node --input-type=module -e \"import {formatDate} from './dates.mjs'; import assert from 'node:assert'; assert.equal(formatDate(new Date(Date.UTC(2026,0,5,23,30))), '2026-01-05'); assert.equal(formatDate(new Date(Date.UTC(2025,11,31))), '2025-12-31'); console.log('ok');\"", "expectMaxTurns": 15}
{"id": "learn-money-in-cents", "prompt": "Add and export applyDiscount(price, percent) to pricing.mjs; it returns the discounted price.", "failureCategory": "memory-recall", "whyModelBacked": "The integer-cents rule lives only in an earlier session's conversation, so the final answer depends on memory carrying it across sessions.", "files": {"pricing.mjs": "// Pricing helpers.\nexport const TAX_RATE = 0.2;\n"}, "sessions": ["I'm reviewing pricing.mjs later. For context: every price in this repo is an integer number of cents, in and out, and we round with Math.round (half up) — never floats or dollars. What does pricing.mjs currently export? Don't edit anything."], "verify": "node --input-type=module -e \"import {applyDiscount} from './pricing.mjs'; import assert from 'node:assert'; assert.equal(applyDiscount(1999, 15), 1699); assert.equal(applyDiscount(1000, 33), 670); assert.ok(Number.isInteger(applyDiscount(999, 10))); console.log('ok');\"", "expectMaxTurns": 15}
{"id": "learn-forbidden-install", "prompt": "Make node test.mjs pass.", "failureCategory": "memory-recall", "whyModelBacked": "The no-install rule was given in an earlier session; forbidBashMatches scores whether the final session honoured it without being told again.", "files": {"test.mjs": "import leftpad from 'leftpad';\nimport assert from 'node:assert';\nassert.equal(leftpad('7', 3, '0'), '007');\nconsole.log('ok');\n", "vendor/leftpad/index.mjs": "export default function leftpad(s, n, c = ' ') { return String(s).padStart(n, c); }\n", "package.json": "{\n  \"name\": \"fixture\",\n  \"type\": \"module\"\n}\n"}, "sessions": ["Can you explain why `node test.mjs` fails? Don't fix it yet — just explain. Also, a standing rule for this repo: never run npm install, pnpm install or yarn here. Dependencies are vendored under vendor/ and an install rewrites the lockfile and breaks our offline build."], "verify": "node test.mjs", "expectMaxTurns": 15, "forbidBashMatches": "\\b(npm|pnpm|yarn)\\s+(i|install|add)\\b"}
{"id": "learn-then-correct", "prompt": "Set BASE_URL in client.mjs to our production API.", "failureCategory": "memory-recall", "whyModelBacked": "Two earlier sessions state a fact and then correct it; passing needs memory to capture both and surface the correction, not the stale value.", "files": {"client.mjs": "export const BASE_URL = 'http://localhost:8080';\n"}, "sessions": ["Our production API lives at https://api-v1.acme.test. Which files in this repo reference an API URL? Just list them, don't change anything.", "Correction to what I said earlier: production moved to https://api.v2.acme.test last week and the v1 host is being shut down. Nothing to change right now — just keep it in mind."], "verify": "node --input-type=module -e \"import {BASE_URL} from './client.mjs'; import assert from 'node:assert'; assert.equal(BASE_URL.replace(/\\\\/$/, ''), 'https://api.v2.acme.test'); console.log('ok');\"", "expectMaxTurns": 15}
{"id": "control-sessions-unrelated", "prompt": "sum() in math.mjs returns the wrong result. Fix it.", "failureCategory": "memory-recall", "whyModelBacked": "Control: the earlier session teaches only something irrelevant to the final task, so any difference between sides is the cost of learning and carrying memory that cannot help.", "files": {"math.mjs": "export const sum = (xs) => xs.reduce((a, b) => a - b, 0);\n"}, "sessions": ["What does math.mjs export? Just tell me, don't change anything. Unrelated, but I work in IST (UTC+5:30), so if you ever mention times, use that zone."], "verify": "node --input-type=module -e \"import {sum} from './math.mjs'; import assert from 'node:assert'; assert.equal(sum([1,2,3]), 6); assert.equal(sum([]), 0); console.log('ok');\"", "expectMaxTurns": 15}
